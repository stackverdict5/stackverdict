---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style is:global>
			/* is:global osigurava da pregažemo sve podrazumevane bele pozadine */
			body {
				background-color: #0b0f17 !important; /* Tamna moderna pozadina */
				color: #e2e8f0 !important;
			}
			main {
				max-width: 960px;
				margin: 0 auto;
				padding: 2em 1em;
			}
		</style>
		<style>
			.hero {
				text-align: center;
				padding: 3.5em 1.5em;
				background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
				color: #ffffff;
				border-radius: 16px;
				margin-bottom: 2.5em;
				border: 1px solid #1e293b;
				box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
			}
			.hero h1 {
				font-size: 3em;
				margin-bottom: 0.3em;
				color: #ffffff;
				font-weight: 800;
			}
			.hero p {
				font-size: 1.25em;
				color: #94a3b8;
				max-width: 650px;
				margin: 0 auto 1.5em auto;
				line-height: 1.6;
			}
			.badge {
				background: #2563eb;
				color: white;
				padding: 0.35em 1em;
				border-radius: 20px;
				font-size: 0.8em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 1.2px;
				display: inline-block;
				margin-bottom: 1.2em;
			}
			
			.value-props {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1.5em;
				margin-bottom: 3em;
			}
			.prop-card {
				background: #111827;
				padding: 1.5em;
				border-radius: 12px;
				border: 1px solid #1f293d;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
			}
			.prop-card h3 {
				margin-top: 0;
				font-size: 1.1em;
				color: #f1f5f9;
			}
			.prop-card p {
				margin-bottom: 0;
				font-size: 0.95em;
				color: #94a3b8;
				line-height: 1.5;
			}

			.section-title {
				font-size: 1.8em;
				margin-bottom: 1em;
				color: #f8fafc;
				font-weight: 700;
				border-bottom: 1px solid #1e293b;
				padding-bottom: 0.4em;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2em;
				list-style-type: none;
				padding: 0;
			}
			.post-card {
				background: #111827;
				border: 1px solid #1f293d;
				border-radius: 12px;
				padding: 1.8em;
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.post-card:hover {
				transform: translateY(-4px);
				border-color: #3b82f6;
				box-shadow: 0 12px 24px -5px rgba(0, 0, 0, 0.4);
			}
			.post-card h3 {
				margin: 0 0 0.6em 0;
				font-size: 1.35em;
			}
			.post-card h3 a {
				color: #f8fafc;
				text-decoration: none;
			}
			.post-card h3 a:hover {
				color: #60a5fa;
			}
			.post-card p {
				color: #94a3b8;
				font-size: 0.95em;
				line-height: 1.6;
				margin-bottom: 1.5em;
			}
			.read-more {
				font-weight: 700;
				color: #60a5fa;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<span class="badge">Developer Tools & SaaS Reviews</span>
				<h1>StackVerdict</h1>
				<p>Independent, benchmarks-driven reviews of AI coding assistants, developer software, and cloud infrastructure.</p>
			</section>

			<section class="value-props">
				<div class="prop-card">
					<h3>⚡ Hands-on Benchmarks</h3>
					<p>We test context windows, latency, and real-world accuracy across complex codebases.</p>
				</div>
				<div class="prop-card">
					<h3>🔍 Transparent Analysis</h3>
					<p>Detailed breakdowns of pricing plans, limitations, and hidden tier boundaries.</p>
				</div>
				<div class="prop-card">
					<h3>🛡️ Unbiased Reviews</h3>
					<p>Editorial independence comes first. Vendor sponsorship never influences our ratings.</p>
				</div>
			</section>

			<section>
				<h2 class="section-title">Latest Verdicts & Deep Dives</h2>
				<ul class="posts-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<div>
									<h3>
										<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
									</h3>
									<p>{post.data.description}</p>
								</div>
								<a href={`/blog/${post.slug}/`} class="read-more">Read Full Verdict &rarr;</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 3em 1em 2em 1em;
				background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
				color: #ffffff;
				border-radius: 12px;
				margin-bottom: 3em;
				box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
			}
			.hero h1 {
				font-size: 2.8em;
				margin-bottom: 0.2em;
				color: #ffffff;
			}
			.hero p {
				font-size: 1.2em;
				color: #94a3b8;
				max-width: 600px;
				margin: 0 auto 1.5em auto;
			}
			.badge {
				background: #3b82f6;
				color: white;
				padding: 0.3em 0.8em;
				border-radius: 20px;
				font-size: 0.85em;
				font-weight: bold;
				text-transform: uppercase;
				letter-spacing: 1px;
				display: inline-block;
				margin-bottom: 1em;
			}
			.section-title {
				font-size: 1.8em;
				margin-bottom: 1em;
				border-bottom: 2px solid #e2e8f0;
				padding-bottom: 0.3em;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2em;
				list-style-type: none;
				padding: 0;
			}
			.post-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 8px;
				padding: 1.5em;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.08);
			}
			.post-card h3 {
				margin: 0 0 0.5em 0;
				font-size: 1.3em;
			}
			.post-card h3 a {
				color: #0f172a;
				text-decoration: none;
			}
			.post-card h3 a:hover {
				color: #2563eb;
			}
			.post-card p {
				color: #64748b;
				font-size: 0.95em;
				line-height: 1.5;
				margin-bottom: 1.5em;
			}
			.read-more {
				font-weight: bold;
				color: #2563eb;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Sekcija -->
			<section class="hero">
				<span class="badge">Developer Tools & SaaS Reviews</span>
				<h1>StackVerdict</h1>
				<p>Unbiased, hands-on comparisons of AI coding assistants, developer software, and cloud infrastructure.</p>
			</section>

			<!-- Najnovije Recenzije -->
			<section>
				<h2 class="section-title">Latest Verdicts & Reviews</h2>
				<ul class="posts-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<div>
									<h3>
										<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
									</h3>
									<p>{post.data.description}</p>
								</div>
								<a href={`/blog/${post.slug}/`} class="read-more">Read Review &rarr;</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>